<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- GroupsEntity -->
    <changeSet id="1" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="groups"/>
            </not>
        </preConditions>
        <createTable tableName="groups">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="profile" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="file_ids" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="job_id" type="INTEGER"/>
        </createTable>
    </changeSet>

    <!-- FilesEntity -->
    <changeSet id="2" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="files"/>
            </not>
        </preConditions>
        <createTable tableName="files">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="profile" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="modified" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="hashPath" type="TEXT"/>
            <column name="fileName" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="newFileName" type="TEXT"/>
            <column name="isUnique" type="BOOLEAN"/>
            <column name="groupId" type="BIGINT"/>
            <column name="hashId" type="BIGINT"/>
            <column name="hash" type="TEXT"/>
            <column name="hashType" type="TEXT"/>
            <column name="state" type="TEXT" defaultValue="ON_PLACE"/>
            <column name="hold" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="job_id" type="INTEGER"/>
        </createTable>
    </changeSet>

    <!-- HashesEntity -->
    <changeSet id="3" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="hashes"/>
            </not>
        </preConditions>
        <createTable tableName="hashes">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="profile" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="hash" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="hashType" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="main" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="duplicates" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="job_id" type="INTEGER"/>
        </createTable>
    </changeSet>

    <!-- ProfileEntity -->
    <changeSet id="4" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="profile"/>
            </not>
        </preConditions>
        <createTable tableName="profile">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(256)"/>
            <column name="cfg" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- SourcesEntity -->
    <changeSet id="5" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="sources"/>
            </not>
        </preConditions>
        <createTable tableName="sources">
            <column name="id" type="INTEGER" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="profile" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="dirorder" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="6" author="admin">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="jobs"/>
            </not>
        </preConditions>
        <createTable tableName="jobstask">
            <column name="id" type="INTEGER">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="profile" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="priority" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="start" type="BIGINT"/>
            <column name="finish" type="BIGINT"/>

            <column name="disabled" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="TEXT"/>

            <column name="lastObjectId" type="INTEGER"/>

            <column name="objects" type="TEXT"/>
            <column name="history" type="TEXT"/>

            <column name="status" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
